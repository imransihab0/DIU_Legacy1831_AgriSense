# --- LLM provider toggle: "openai" (primary) or "anthropic" (fallback) ---
LLM_PROVIDER=openai

# OpenAI (primary — using hackathon Codex/OpenAI credit)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1

# Anthropic (fallback — flip LLM_PROVIDER=anthropic if OpenAI credit fails)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# bdapps TAP API (get applicationId + password from the bdapps developer portal
# or the organizers). Leave empty -> local simulation with identical API shapes.
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_BASE_URL=https://developer.bdapps.com
